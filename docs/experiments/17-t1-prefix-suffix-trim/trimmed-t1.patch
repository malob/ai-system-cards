+def _occurs_elsewhere(haystack: list, needle: list, aligned_at: int | None,
+                      extend: tuple[int, object] | None = None) -> bool:
+    """Does ``needle`` occur in ``haystack`` at a token index other than
+    ``aligned_at``?  With ``extend=(offset, token)`` an occurrence at index q
+    only counts when ``haystack[q + offset] == token`` — the shifted block must
+    continue across the boundary. Token sequences are joined on NUL so the C
+    substring search does the work; a match must start and end on a token
+    boundary."""
+    if not needle or len(needle) > len(haystack):
+        return False
+    text = "\x00" + "\x00".join(haystack) + "\x00"
+    pattern = "\x00" + "\x00".join(needle) + "\x00"
+    offsets = None
+    if aligned_at is not None or extend is not None:
+        offsets, total = [], 0
+        for tok in haystack:
+            offsets.append(total)
+            total += len(tok) + 1
+    aligned_offset = offsets[aligned_at] if aligned_at is not None and aligned_at < len(offsets) else None
+    pos = text.find(pattern)
+    while pos != -1:
+        if pos != aligned_offset:
+            if extend is None:
+                return True
+            q = bisect.bisect_left(offsets, pos) + extend[0]
+            if 0 <= q < len(haystack) and haystack[q] == extend[1]:
+                return True
+        pos = text.find(pattern, pos + 1)
+    return False
+
+
+def _full_opcodes(a: list, b: list) -> list[tuple]:
+    sm = difflib.SequenceMatcher(a=a, b=b, autojunk=False)
+    return [op for op in sm.get_opcodes() if op[0] != "equal"]
+
+
+def trimmed_opcodes(a: list, b: list, window: int = 8) -> list[tuple]:
+    """difflib's non-equal opcodes for ``a`` vs ``b``, computed by diffing
+    only the window between the shared prefix P and suffix S.
+
+    The result is the untrimmed matcher's exactly. difflib picks the longest
+    block first (ties: earliest in ``a``, then in ``b``), so P and S are taken
+    whole unless some block overlapping P shifted is longer than P, or some
+    block overlapping S shifted is at least as long as S. Any such block must
+    carry either ``window`` tokens of the far side of the boundary, or the
+    boundary region minus ``window`` tokens, to a shifted position in the
+    other sequence. Those eight substring searches are linear and almost never
+    hit on real documents; when one does, or when P or S is shorter than the
+    window, the full matcher runs. ``test_t1_trim`` replays the equivalence
+    against difflib on seeded random and periodic corpora.
+    """
+    n = min(len(a), len(b))
+    p = 0
+    while p < n and a[p] == b[p]:
+        p += 1
+    s = 0
+    while s < n - p and a[len(a) - 1 - s] == b[len(b) - 1 - s]:
+        s += 1
+    w = window
+    if (p and p < w) or (s and s < w):
+        return _full_opcodes(a, b)
+    if p:
+        # A block longer than P overlapping P shifted continues past p by m
+        # tokens; if m >= w that continuation occurs shifted with the block
+        # reaching back into P, otherwise its P-part starts at or before w - 2
+        # and covers P[w - 1:].
+        if (p + w <= len(a) and _occurs_elsewhere(b, a[p:p + w], None, (-1, a[p - 1]))) or \
+           (p + w <= len(b) and _occurs_elsewhere(a, b[p:p + w], None, (-1, b[p - 1]))) or \
+           _occurs_elsewhere(b, a[w - 1:p], w - 1) or \
+           _occurs_elsewhere(a, b[w - 1:p], w - 1):
+            return _full_opcodes(a, b)
+    if s:
+        qa, qb = len(a) - s, len(b) - s
+        # A block at least as long as S overlapping S shifted (or an earlier
+        # copy of S) reaches back >= w tokens before S and on into S, or
+        # covers S[:s - w + 1].
+        if (qa >= w and _occurs_elsewhere(b, a[qa - w:qa], qb - w, (w, a[qa]))) or \
+           (qb >= w and _occurs_elsewhere(a, b[qb - w:qb], qa - w, (w, b[qb]))) or \
+           _occurs_elsewhere(b, a[qa:qa + s - w + 1], qb) or \
+           _occurs_elsewhere(a, b[qb:qb + s - w + 1], qa):
+            return _full_opcodes(a, b)
+    sm = difflib.SequenceMatcher(a=a[p:len(a) - s], b=b[p:len(b) - s], autojunk=False)
+    return [(op, i1 + p, i2 + p, j1 + p, j2 + p)
+            for op, i1, i2, j1, j2 in sm.get_opcodes() if op != "equal"]
+
