--- /dev/null
+++ b/pipeline/verifier/test_t1_trim.py
@@ -0,0 +1,81 @@
+"""Common prefix/suffix trimming must not change T1's opcodes.
+
+``invariants.t1_text`` diffs the whole document's token streams. Trimming the
+shared prefix and suffix before the quadratic matcher runs is only admissible
+if every opcode — and therefore every acceptance fingerprint and mutation
+digest — is identical to the untrimmed matcher's. This test replays the
+trimmed and untrimmed matchers over seeded random documents with local edits
+(the shapes the mutation suite injects) and demands identical opcodes.
+"""
+
+from __future__ import annotations
+
+import difflib
+import random
+import unittest
+
+import invariants
+
+
+def _reference(a: list[str], b: list[str]) -> list[tuple]:
+    sm = difflib.SequenceMatcher(a=a, b=b, autojunk=False)
+    return [op for op in sm.get_opcodes() if op[0] != "equal"]
+
+
+def _mutate(tokens: list[str], rng: random.Random) -> list[str]:
+    out = list(tokens)
+    for _ in range(rng.randint(1, 3)):
+        kind = rng.choice(["delete", "insert", "replace", "swap", "dup"])
+        if not out:
+            break
+        i = rng.randrange(len(out))
+        n = rng.randint(1, 6)
+        if kind == "delete":
+            del out[i:i + n]
+        elif kind == "insert":
+            out[i:i] = [rng.choice("abcdefgh") for _ in range(n)]
+        elif kind == "replace":
+            out[i:i + n] = [rng.choice("abcdefgh") for _ in range(n)]
+        elif kind == "swap" and i + 1 < len(out):
+            out[i], out[i + 1] = out[i + 1], out[i]
+        elif kind == "dup":
+            out[i:i] = out[i:i + n]
+    return out
+
+
+class TrimEquivalenceTests(unittest.TestCase):
+    def test_trimmed_opcodes_match_reference_on_random_local_edits(self):
+        rng = random.Random(5)
+        vocab = list("abcdefgh")  # small alphabet → many repeats → ambiguity
+        mismatches = []
+        for trial in range(2000):
+            n = rng.randint(0, 120)
+            a = [rng.choice(vocab) for _ in range(n)]
+            b = _mutate(a, rng) if rng.random() < 0.95 else list(a)
+            got = invariants.trimmed_opcodes(a, b, window=rng.choice([1, 2, 4, 8]))
+            want = _reference(a, b)
+            if got != want:
+                mismatches.append((trial, a, b, got, want))
+        self.assertEqual(mismatches, [], f"{len(mismatches)} mismatching trials; first: {mismatches[:1]}")
+
+    def test_periodic_and_repetitive_corpora_match_reference(self):
+        rng = random.Random(11)
+        mismatches = 0
+        for trial in range(3000):
+            period = [rng.choice("abc") for _ in range(rng.randint(1, 4))]
+            reps = rng.randint(1, 12)
+            a = (period * reps)[: rng.randint(0, 40)] + [rng.choice("xyz") for _ in range(rng.randint(0, 10))] + (period * reps)[: rng.randint(0, 40)]
+            b = _mutate(a, rng)
+            if rng.random() < 0.3:
+                b = _mutate(b, rng)
+            if invariants.trimmed_opcodes(a, b, window=rng.choice([1, 2, 3, 8])) != _reference(a, b):
+                mismatches += 1
+        self.assertEqual(mismatches, 0)
+
+    def test_edges(self):
+        for a, b in ([], []), (["x"], []), ([], ["x"]), (["x"], ["x"]), (["x", "y"], ["y", "x"]), (["a"] * 5, ["a"] * 7):
+            self.assertEqual(invariants.trimmed_opcodes(a, b), _reference(a, b), (a, b))
+
+
+if __name__ == "__main__":
+    unittest.main()
